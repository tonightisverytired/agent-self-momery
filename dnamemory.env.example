# ============================================================================
# dnamemory 项目配置文件（.env 风格，零依赖）
#
# 用法：复制为 dnamemory.env 放在当前目录（或项目根），按需修改即可；
#       三个入口 dnamemory / dnamemory-server / dnamemory-mcp 都会自动读取。
#
# 查找顺序：--config 参数 > DNAMEMORY_CONFIG 环境变量 >
#           ./dnamemory.env > ~/.dnamemory.env
#
# 优先级：命令行参数 > 真实环境变量 > 本文件 > 内置默认值
#        （已存在的环境变量不会被本文件覆盖——容器/systemd 注入的运行时值优先）
#
# 只识别 DNAMEMORY_ / DEEPSEEK_ 前缀的键；其它键保留在文件里但不生效。
# 语法：# 开头为注释；KEY=VALUE；值可用单/双引号包裹（引号内保留原样）。
# ============================================================================

# ---------------------------------------------------------------------------
# 服务（dnamemory-server / dnamemory-mcp --transport streamable_http）
# ---------------------------------------------------------------------------

# 监听地址。默认 127.0.0.1（仅本机）；对外提供服务改成 0.0.0.0
DNAMEMORY_HOST=127.0.0.1

# 监听端口
DNAMEMORY_PORT=8000

# 访问令牌（必填）。所有 API 都要求 Authorization: Bearer <token>。
# 对外暴露时务必换成足够长的随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DNAMEMORY_TOKEN=change-me

# 跨域白名单（逗号分隔）。默认仅允许本机任意端口；外部前端调用时在这里
# 显式列出它所在的源，不要用 *（本项目不用通配符）。
# 例：DNAMEMORY_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# DNAMEMORY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 存储（默认 SQLite；需要多进程共享/运维时切 PostgreSQL）
# ---------------------------------------------------------------------------

# SQLite 库路径（不设 DNAMEMORY_DSN 时生效）
DNAMEMORY_DB=user_memory.db

# PostgreSQL DSN。设了就改用 PG 存储（忽略 DNAMEMORY_DB）。
# 先起库：docker compose -f docker-compose.pg.yml up -d
# 迁移数据：py ops/migrate_sqlite_to_pg.py --src user_memory.db --dsn <DSN>
# DNAMEMORY_DSN=postgresql://dnatest:dnatest@127.0.0.1:5433/dnamemory

# ---------------------------------------------------------------------------
# LLM 抽取（可选；不设则服务端 /write 报 400 E010，除非启动加 --fallback-extractor。
# 0.8.3 起设置本 key 即自动启用「LLM 优先 + 失败兜底」抽取链，无需额外参数）
# ---------------------------------------------------------------------------

# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型选择：deepseek-chat 候选产出与事实/观点覆盖实测最优（2026-09 对拍）；
# deepseek-v4-pro/v4-flash 偏保守（闲聊语料下倾向只抽 event）。
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 本地模型目录（可选；不设则从 HuggingFace 缓存/下载）
# ---------------------------------------------------------------------------

# DNAMEMORY_BGE_PATH=F:/models/embedding/bge-m3
# DNAMEMORY_RERANKER_PATH=F:/models/reranker/bge-reranker-v2-m3

# ---------------------------------------------------------------------------
# 第一人称主体名（可选，默认「用户」）：写入时「我/自己/user」归一到它，
# 库中缺该主体时自动建 person 节点
# ---------------------------------------------------------------------------

# DNAMEMORY_USER_NAME=用户
